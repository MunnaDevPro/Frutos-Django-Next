# Always use LF for shell scripts — CRLF breaks bash on Linux/Docker
*.sh text eol=lf

# Always use LF for Docker files
Dockerfile text eol=lf
docker-compose.yml text eol=lf
*.conf text eol=lf

# Python files — LF
*.py text eol=lf

# JS/TS files — LF
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.mjs text eol=lf

# Config files — LF
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.env text eol=lf

# Binary files — no line ending conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf
